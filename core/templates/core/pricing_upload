<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Upload Pricing CSV</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    :root { --bg-main:#020617; --bg-card:#0b1120; --accent:#facc15; --text:#e5e7eb; --muted:#9ca3af; --border:#1f2937; }
    body{margin:0;padding:24px;font-family:system-ui;background:radial-gradient(circle at top, rgba(250,204,21,.16), transparent 55%) var(--bg-main);color:var(--text);}
    .page{max-width:980px;margin:0 auto;}
    .card{background:var(--bg-card);border:1px solid var(--border);border-radius:18px;padding:20px;box-shadow:0 18px 45px rgba(0,0,0,.55);}
    a{color:var(--accent);text-decoration:none;}
    input[type=file]{display:block;margin-top:8px;color:var(--muted);}
    .btn{display:inline-block;margin-top:12px;background:var(--accent);color:#111827;padding:10px 14px;border-radius:12px;border:none;font-weight:700;cursor:pointer;}
  </style>
</head>
<body>
  <div class="page">
    <div class="card">
      <h1>Upload Pricing CSV</h1>
      <p style="color:var(--muted);margin-top:6px;">This imports the pricing matrix and updates prices without overwriting saved pallet quantities.</p>

      <form method="post" enctype="multipart/form-data">
        {% csrf_token %}
        {{ form.file.label_tag }}
        {{ form.file }}
        <button class="btn" type="submit">Import Pricing</button>
      </form>

      <p style="margin-top:14px;">
        <a href="{% url 'pricing_customer_list' %}">View customers</a>
      </p>
    </div>
  </div>
</body>
</html>
